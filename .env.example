# Leave the Supabase vars empty to run in DEMO MODE (in-memory seed data, no login).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by scripts/seed.ts and /api/cron/* routes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Optional (milestone 9)
COMTRADE_API_KEY=
# Protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=
